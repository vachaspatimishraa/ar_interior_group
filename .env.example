# Public canonical origin (required for production SEO and enquiry Origin checks).
# Used at build time for metadata and at runtime by sitemap.xml, robots.txt, and the enquiry API.
# Set this to the exact approved HTTPS origin only (scheme + host, no path or trailing slash).
# Example placeholder only; do not deploy using this value.
SITE_URL=https://www.example.com

# Server-only, production enquiry configuration. All are required to enable submissions.
# RESEND_API_KEY: Resend secret; never expose as NEXT_PUBLIC_*.
RESEND_API_KEY=your-resend-api-key
# Must be a sender/domain verified with Resend; use the actual approved sender before launch.
ENQUIRY_FROM_EMAIL=AR Interior Group <enquiries@example.com>
# Placeholder recipient; replace with the approved company enquiry address.
ENQUIRY_TO_EMAIL=enquiries@example.com

# Server-only Upstash Redis REST credentials; both are required for rate limiting/idempotency.
# Missing or partial configuration fails closed (503); abuse protection is not bypassed.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Required server-side policy setting for the production edge/proxy.
# Choose only a header that the trusted edge overwrites with one client IP on every request.
# Supported: x-real-ip or cf-connecting-ip. Never trust a client-passthrough header.
ENQUIRY_TRUSTED_IP_HEADER=x-real-ip
